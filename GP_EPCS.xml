<dcc:digitalCalibrationCertificate
	xmlns:dcc="https://ptb.de/dcc"
	xmlns:si="https://ptb.de/si"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://ptb.de/dcc https://ptb.de/dcc/dcc.xsd"
	schemaVersion="3.3.0">
	<!-- ================= Administrative Data ================= -->
	<dcc:administrativeData>
		<dcc:coreData>
			<dcc:countryCodeISO3166_1>CN</dcc:countryCodeISO3166_1>
			<dcc:usedLangCodeISO639_1>zh</dcc:usedLangCodeISO639_1>
			<dcc:usedLangCodeISO639_1>en</dcc:usedLangCodeISO639_1>
			<dcc:mandatoryLangCodeISO639_1>zh</dcc:mandatoryLangCodeISO639_1>
			<dcc:mandatoryLangCodeISO639_1>en</dcc:mandatoryLangCodeISO639_1>
			<dcc:uniqueIdentifier>{{pid_number}}</dcc:uniqueIdentifier>
			<dcc:identifications>
				<dcc:identification refType="basic_certificateNumber">
					<dcc:issuer>calibrationLaboratory</dcc:issuer>
					<dcc:value>{{certificate_number}}</dcc:value>
					<dcc:name>
						<dcc:content lang="zh">校准证书编号</dcc:content>
						<dcc:content lang="en">Calibration certificate number</dcc:content>
					</dcc:name>
				</dcc:identification>
			</dcc:identifications>
			<dcc:beginPerformanceDate>2026-03-13</dcc:beginPerformanceDate>
			<dcc:endPerformanceDate>2026-03-13</dcc:endPerformanceDate>
			<dcc:performanceLocation id="staticPerformanceLocation">customer</dcc:performanceLocation>
			<dcc:issueDate>2026-03-14</dcc:issueDate>
		</dcc:coreData>
		<dcc:dccSoftware>
			<dcc:software>
				<dcc:name>
					<dcc:content>{{dcc_software_name}}</dcc:content>
				</dcc:name>
				<dcc:release>{{dcc_software_release}}</dcc:release>
				<dcc:type>editor</dcc:type>
			</dcc:software>
		</dcc:dccSoftware>
		<dcc:refTypeDefinitions>
			<dcc:refTypeDefinition>
				<dcc:name>
					<dcc:content lang="zh">通用术语</dcc:content>
					<dcc:content lang="en">General terms</dcc:content>
				</dcc:name>
				<dcc:namespace>basic</dcc:namespace>
				<dcc:link>https://digilab.ptb.de/dkd/refType/vocab/index.php?tema=2&amp;/basic</dcc:link>
			</dcc:refTypeDefinition>
			<dcc:refTypeDefinition>
				<dcc:name>
					<dcc:content lang="zh">数学术语和运算符</dcc:content>
					<dcc:content lang="en">Mathematical terms and operators</dcc:content>
				</dcc:name>
				<dcc:namespace>math</dcc:namespace>
				<dcc:link>https://digilab.ptb.de/dkd/refType/vocab/index.php?tema=292&amp;/math</dcc:link>
			</dcc:refTypeDefinition>
			<dcc:refTypeDefinition>
				<dcc:name>
					<dcc:content lang="zh">非自动衡器专用术语</dcc:content>
					<dcc:content lang="en">Specific refTypes for weighing instruments</dcc:content>
				</dcc:name>
				<dcc:namespace>NAWI</dcc:namespace>
				<dcc:link>https://digilab.ptb.de/dkd/refType/vocab/index.php?tema=278&amp;/nawi</dcc:link>
			</dcc:refTypeDefinition>
			<dcc:refTypeDefinition>
				<dcc:name>
					<dcc:content lang="zh">JJG 1204-2025术语</dcc:content>
					<dcc:content lang="en">Electronic Price-Computing Scale Verification Regulation JJG 12004-2025</dcc:content>
				</dcc:name>
				<dcc:namespace>jjg1204</dcc:namespace>
				<dcc:link>https://jjg.spc.org.cn/resmea/standard/JJF%25202184-2025/</dcc:link>
			</dcc:refTypeDefinition>
		</dcc:refTypeDefinitions>
		<dcc:items>
			<dcc:item refType="jjg1204_electronicPriceComputingScale">
				<dcc:name>
					<dcc:content lang="zh">电子计价秤</dcc:content>
					<dcc:content lang="en">Electronic Price Computing Scale</dcc:content>
				</dcc:name>
				<dcc:equipmentClass refType="jjg1204_accuracyClass">
					<dcc:reference>JJG 1204-2025 电子计价秤检定规程（试行）</dcc:reference>
					<dcc:classID>中准确度级</dcc:classID>
				</dcc:equipmentClass>
				<dcc:equipmentClass>
					<dcc:reference>计量器具命名与分类编码</dcc:reference>
					<dcc:classID>12040500</dcc:classID>
				</dcc:equipmentClass>
				<dcc:equipmentClass>
					<dcc:reference>OIML R76-1</dcc:reference>
					<dcc:classID>T.1.2.8</dcc:classID>
					<dcc:link>https://www.oiml.org/en/files/pdf_r/r076-1-e06.pdf</dcc:link>
				</dcc:equipmentClass>
				<dcc:equipmentClass>
					<dcc:reference>非自动衡器通用技术要求</dcc:reference>
					<dcc:classID>3.1.2.8</dcc:classID>
				</dcc:equipmentClass>
				<dcc:equipmentClass>
					<dcc:reference>DKD-E 7-3 Instructions on how to use the DCC schema to create a digital calibration certificate for non-automatic weighing instruments</dcc:reference>
					<dcc:classID>NAWI-SR</dcc:classID>
					<dcc:link>https://doi.org/10.7795/550.20250325</dcc:link>
				</dcc:equipmentClass>
				<dcc:manufacturer>
					<dcc:name>
						<dcc:content>{{manufacturer_name}}</dcc:content>
					</dcc:name>
				</dcc:manufacturer>
				<dcc:model>{{instrument_model}}</dcc:model>
				<dcc:identifications>
					<dcc:identification refType="basic_serialNumber">
						<dcc:issuer>manufacturer</dcc:issuer>
						<dcc:value>{{serial_number}}</dcc:value>
						<dcc:name>
							<dcc:content lang="zh">出厂编号</dcc:content>
							<dcc:content lang="en">Serial number</dcc:content>
						</dcc:name>
					</dcc:identification>
					<dcc:identification refType="jjg1204_softwareIdentification">
						<dcc:issuer>manufacturer</dcc:issuer>
						<dcc:value>{{software_identification}}</dcc:value>
						<dcc:name>
							<dcc:content lang="zh">软件标识</dcc:content>
							<dcc:content lang="en">Software identification</dcc:content>
						</dcc:name>
					</dcc:identification>
					<dcc:identification>
						<dcc:issuer>other</dcc:issuer>
						<dcc:value>{{type_approval_number}}</dcc:value>
						<dcc:name>
							<dcc:content lang="zh">型式批准编号</dcc:content>
							<dcc:content lang="en">Type approval number</dcc:content>
						</dcc:name>
					</dcc:identification>
					<dcc:identification refType="jjg1204_uniqueInformationIdentifier">
						<dcc:issuer>other</dcc:issuer>
						<dcc:value>{{national_unique_identifier}}</dcc:value>
						<dcc:name>
							<dcc:content lang="zh">全国电子秤智慧监管平台唯一码</dcc:content>
							<dcc:content lang="en">National smart supervision platform unique identifier</dcc:content>
						</dcc:name>
					</dcc:identification>
				</dcc:identifications>
				<dcc:itemQuantities>
					<dcc:itemQuantity>
						<dcc:noQuantity refType="jjg1204_sealingMarkStatus">
							<dcc:name>
								<dcc:content lang="zh">封印状态</dcc:content>
								<dcc:content lang="en">Sealing mark status</dcc:content>
							</dcc:name>
							<dcc:content lang="zh">封印状态完好</dcc:content>
							<dcc:content lang="en">Sealing mark intact</dcc:content>
						</dcc:noQuantity>
					</dcc:itemQuantity>
					<dcc:itemQuantity refType="jjg1204_manufacturingDate">
						<dcc:noQuantity>
							<dcc:name>
								<dcc:content lang="zh">制造日期</dcc:content>
								<dcc:content lang="en">Manufacturing date</dcc:content>
							</dcc:name>
							<dcc:content>2026-01-01</dcc:content>
						</dcc:noQuantity>
					</dcc:itemQuantity>
				</dcc:itemQuantities>
				<dcc:subItems>
					<dcc:item refType="NAWI_range1" id="range1">
						<dcc:name>
							<dcc:content lang="zh">称量范围 1</dcc:content>
							<dcc:content lang="en">Weighing range 1</dcc:content>
						</dcc:name>
						<dcc:identifications>
							<dcc:identification>
								<dcc:issuer>manufacturer</dcc:issuer>
								<dcc:value>1</dcc:value>
								<dcc:name>
									<dcc:content lang="zh">称量范围</dcc:content>
									<dcc:content lang="en">Weighing range</dcc:content>
								</dcc:name>
							</dcc:identification>
						</dcc:identifications>
						<dcc:itemQuantities>
							<dcc:itemQuantity refType="math_minimum">
								<si:real>
									<si:value>0.2</si:value>
									<si:unit>\kilogram</si:unit>
								</si:real>
							</dcc:itemQuantity>
							<dcc:itemQuantity refType="math_maximum">
								<si:real>
									<si:value>30</si:value>
									<si:unit>\kilogram</si:unit>
								</si:real>
							</dcc:itemQuantity>
							<dcc:itemQuantity refType="NAWI_resolutionOfDisplayingDevice">
								<si:real>
									<si:value>0.01</si:value>
									<si:unit>\kilogram</si:unit>
								</si:real>
							</dcc:itemQuantity>
						</dcc:itemQuantities>
					</dcc:item>
				</dcc:subItems>
			</dcc:item>
		</dcc:items>
		<dcc:calibrationLaboratory>
			<dcc:contact>
				<dcc:name>
					<dcc:content>{{calibration_laboratory_name}}</dcc:content>
				</dcc:name>
				<dcc:location>
					<dcc:city>{{laboratory_city}}</dcc:city>
					<dcc:countryCode>CN</dcc:countryCode>
					<dcc:postCode>{{laboratory_post_code}}</dcc:postCode>
					<dcc:street>{{laboratory_street}}</dcc:street>
					<dcc:streetNo>{{laboratory_street_number}}</dcc:streetNo>
				</dcc:location>
			</dcc:contact>
		</dcc:calibrationLaboratory>
		<dcc:respPersons>
			<dcc:respPerson refType="jjg1204_calibrator">
				<dcc:person>
					<dcc:name>
						<dcc:content>{{calibrator_name}}</dcc:content>
					</dcc:name>
				</dcc:person>
				<dcc:role>校准员</dcc:role>
				<dcc:mainSigner>true</dcc:mainSigner>
			</dcc:respPerson>
			<dcc:respPerson refType="jjg1204_reviewer">
				<dcc:person>
					<dcc:name>
						<dcc:content>{{reviewer_name}}</dcc:content>
					</dcc:name>
				</dcc:person>
				<dcc:role>核验员</dcc:role>
				<dcc:mainSigner>false</dcc:mainSigner>
			</dcc:respPerson>
			<dcc:respPerson refType="jjg1204_approver">
				<dcc:person>
					<dcc:name>
						<dcc:content>{{approver_name}}</dcc:content>
					</dcc:name>
				</dcc:person>
				<dcc:role>批准人</dcc:role>
				<dcc:mainSigner>false</dcc:mainSigner>
			</dcc:respPerson>
		</dcc:respPersons>
		<dcc:customer>
			<dcc:name>
				<dcc:content>{{customer_name}}</dcc:content>
			</dcc:name>
			<dcc:eMail>{{customer_email}}</dcc:eMail>
			<dcc:location>
				<dcc:city>{{customer_city}}</dcc:city>
				<dcc:countryCode>CN</dcc:countryCode>
				<dcc:postCode>{{customer_post_code}}</dcc:postCode>
				<dcc:street>{{customer_street}}</dcc:street>
				<dcc:streetNo>{{customer_street_number}}</dcc:streetNo>
			</dcc:location>
		</dcc:customer>
		<dcc:statements>
			<dcc:statement refId="staticPerformanceLocation">
				<dcc:declaration>
					<dcc:content lang="zh">测量结果仅对指定的校准位置有效，用户需自行评估其他位置的有效性。</dcc:content>
					<dcc:content lang="en">The measurement results are only valid for the specified calibration location - it is up to the user to assess the validity for any other installation location.</dcc:content>
				</dcc:declaration>
				<dcc:location>
					<dcc:city>{{calibration_city}}</dcc:city>
					<dcc:countryCode>CN</dcc:countryCode>
					<dcc:postCode>{{calibration_post_code}}</dcc:postCode>
					<dcc:street>{{calibration_street}}</dcc:street>
					<dcc:streetNo>{{calibration_street_number}}</dcc:streetNo>
					<dcc:further>
						<dcc:content lang="zh">部门：</dcc:content>
						<dcc:content lang="en">Department:</dcc:content>
						<dcc:content>{{calibration_department}}</dcc:content>
					</dcc:further>
					<dcc:further>
						<dcc:content lang="zh">楼栋：</dcc:content>
						<dcc:content lang="en">Building:</dcc:content>
						<dcc:content>{{calibration_building}}</dcc:content>
					</dcc:further>
					<dcc:further>
						<dcc:content lang="zh">楼层：</dcc:content>
						<dcc:content lang="en">Floor:</dcc:content>
						<dcc:content>{{calibration_floor}}</dcc:content>
					</dcc:further>
					<dcc:further>
						<dcc:content lang="zh">房间：</dcc:content>
						<dcc:content lang="en">Room:</dcc:content>
						<dcc:content>{{calibration_room}}</dcc:content>
					</dcc:further>
				</dcc:location>
			</dcc:statement>
			<dcc:statement refId="range1" refType="basic_calibratedInterval">
				<dcc:declaration>
					<dcc:content lang="zh">已校准的称量范围：</dcc:content>
					<dcc:content lang="en">Specification of the weighing range that has been calibrated:</dcc:content>
				</dcc:declaration>
				<dcc:data>
					<dcc:quantity refType="math_minimum">
						<dcc:name>
							<dcc:content lang="zh">已校准的称量范围下限</dcc:content>
							<dcc:content lang="en">Lower limit of the calibrated weighing range</dcc:content>
						</dcc:name>
						<si:real>
							<si:value>0.2</si:value>
							<si:unit>\kilogram</si:unit>
						</si:real>
					</dcc:quantity>
					<dcc:quantity refType="math_maximum">
						<dcc:name>
							<dcc:content lang="zh">已校准的称量范围上限</dcc:content>
							<dcc:content lang="en">Upper limit of the calibrated weighing range</dcc:content>
						</dcc:name>
						<si:real>
							<si:value>30</si:value>
							<si:unit>\kilogram</si:unit>
						</si:real>
					</dcc:quantity>
					<dcc:quantity refType="NAWI_resolutionOfDisplayingDevice">
						<dcc:name>
							<dcc:content lang="zh">实际分度值</dcc:content>
							<dcc:content lang="en">Actual Scale Interval</dcc:content>
						</dcc:name>
						<si:real>
							<si:value>0.01</si:value>
							<si:unit>\kilogram</si:unit>
						</si:real>
					</dcc:quantity>
					<dcc:quantity refType="NAWI_verificationScaleInterval">
						<dcc:name>
							<dcc:content lang="zh">检定分度值</dcc:content>
							<dcc:content lang="en">Verification scale interval</dcc:content>
						</dcc:name>
						<si:real>
							<si:value>0.01</si:value>
							<si:unit>\kilogram</si:unit>
						</si:real>
					</dcc:quantity>
				</dcc:data>
			</dcc:statement>
			<dcc:statement refType="basic_calibrationMethod">
				<dcc:name>
					<dcc:content lang="zh">校准依据</dcc:content>
					<dcc:content lang="en">Calibration reference</dcc:content>
				</dcc:name>
				<dcc:norm>JJG 1204-2025 电子计价秤检定规程（试行）</dcc:norm>
				<dcc:declaration>
					<dcc:content lang="zh">本次校准中的测量程序符合 JJG 1204-2025 电子计价秤检定规程（试行）的要求。</dcc:content>
					<dcc:content lang="en">The measurement procedure used for this calibration conforms to JJG 1204-2025, Verification Regulation of Electronic Price-Computing Scales (Trial).</dcc:content>
				</dcc:declaration>
			</dcc:statement>
			<dcc:statement>
				<dcc:name>
					<dcc:content lang="zh">中国计量协会团体标准</dcc:content>
					<dcc:content lang="en">Group standard of the China Metrology Association</dcc:content>
				</dcc:name>
				<dcc:norm>T/CMA ZK157-2025 数字校准证书结构规则</dcc:norm>
				<dcc:declaration>
					<dcc:content lang="zh">本数字校准证书符合 T/CMA ZK157-2025 数字校准证书结构规则的要求。</dcc:content>
					<dcc:content lang="en">This digital calibration certificate conforms to T/CMA ZK157-2025, Structural Rules for Digital Calibration Certificates.</dcc:content>
				</dcc:declaration>
			</dcc:statement>
		</dcc:statements>
	</dcc:administrativeData>

	<!-- ================= Measurement Result ================= -->
	<dcc:measurementResults>
		<dcc:usedMethods>
			<dcc:usedMethod refType="basic_calibrationMethod">
				<dcc:name>
					<dcc:content lang="zh">校准依据:</dcc:content>
					<dcc:content lang="en">Calibration reference:</dcc:content>
				</dcc:name>
				<dcc:norm>JJG 1204-2025 电子计价秤检定规程（试行）</dcc:norm>
			</dcc:usedMethod>
		</dcc:usedMethods>
		<dcc:measuringEquipments>
			<dcc:measuringEquipment refType="basic_measurementStandard jjg1204_calibrationDevice">
				<dcc:name>
					<dcc:content lang="en">NAWI calibration device</dcc:content>
					<dcc:content lang="zh">非自动衡器校准装置</dcc:content>
				</dcc:name>
				<dcc:equipmentClass refType="jjg1204_accuracyClass">
					<dcc:reference>OIML R111-1:2004</dcc:reference>
					<dcc:classID>M1</dcc:classID>
				</dcc:equipmentClass>
				<dcc:description refType="jjg1204_standardValidityEndDate">
					<dcc:name>
						<dcc:content lang="zh">有效期至</dcc:content>
						<dcc:content lang="en">Valid until</dcc:content>
					</dcc:name>
					<dcc:content>2026-09-24T06:00</dcc:content>
				</dcc:description>
				<dcc:identifications>
					<dcc:identification refType="basic_certificateNumber">
						<dcc:issuer>calibrationLaboratory</dcc:issuer>
						<dcc:value>{{calibration_device_certificate_number}}</dcc:value>
					</dcc:identification>
				</dcc:identifications>
				<dcc:measuringEquipmentQuantities>
					<dcc:measuringEquipmentQuantity refType="math_minimum">
						<dcc:name>
							<dcc:content lang="zh">测量范围下限</dcc:content>
							<dcc:content lang="en">Lower limit of measurement range</dcc:content>
						</dcc:name>
						<si:real>
							<si:value>0</si:value>
							<si:unit>\kilogram</si:unit>
						</si:real>
					</dcc:measuringEquipmentQuantity>
					<dcc:measuringEquipmentQuantity refType="math_maximum">
						<dcc:name>
							<dcc:content lang="zh">测量范围上限</dcc:content>
							<dcc:content lang="en">Upper limit of measurement range</dcc:content>
						</dcc:name>
						<si:real>
							<si:value>1200</si:value>
							<si:unit>\kilogram</si:unit>
						</si:real>
					</dcc:measuringEquipmentQuantity>
					<dcc:measuringEquipmentQuantity>
						<dcc:name>
							<dcc:content lang="zh">装置的测量不确定度下限</dcc:content>
							<dcc:content lang="en">Lower limit of device measurement uncertainty</dcc:content>
						</dcc:name>
						<dcc:description>
							<dcc:content>k=2</dcc:content>
						</dcc:description>
						<si:real>
							<si:value>0.00003</si:value>
							<si:unit>\kilogram</si:unit>
						</si:real>
					</dcc:measuringEquipmentQuantity>
					<dcc:measuringEquipmentQuantity>
						<dcc:name>
							<dcc:content lang="zh">装置的测量不确定度上限</dcc:content>
							<dcc:content lang="en">Upper limit of device measurement uncertainty</dcc:content>
						</dcc:name>
						<dcc:description>
							<dcc:content>k=2</dcc:content>
						</dcc:description>
						<si:real>
							<si:value>0.6</si:value>
							<si:unit>\kilogram</si:unit>
						</si:real>
					</dcc:measuringEquipmentQuantity>
				</dcc:measuringEquipmentQuantities>
			</dcc:measuringEquipment>
			<dcc:measuringEquipment refType="basic_measurementStandard jjg1204_standardWeightSet">
				<dcc:name>
					<dcc:content lang="zh">M1等级砝码组</dcc:content>
					<dcc:content lang="en">Weight set M1</dcc:content>
				</dcc:name>
				<dcc:equipmentClass refType="jjg1204_accuracyClass">
					<dcc:reference>JJG 99</dcc:reference>
					<dcc:classID>M1</dcc:classID>
				</dcc:equipmentClass>
				<dcc:description refType="jjg1204_standardValidityEndDate">
					<dcc:name>
						<dcc:content lang="zh">有效期至</dcc:content>
